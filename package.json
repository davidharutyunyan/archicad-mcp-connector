{
  "name": "archicad-connector",
  "version": "1.0.0",
  "description": "MCP server that gives Claude full read/write control of Graphisoft Archicad 26 through the official JSON API and the bundled Claude Connector add-on.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidharutyunyan/archicad-mcp-connector.git"
  },
  "homepage": "https://github.com/davidharutyunyan/archicad-mcp-connector#readme",
  "bugs": {
    "url": "https://github.com/davidharutyunyan/archicad-mcp-connector/issues"
  },
  "type": "module",
  "bin": {
    "archicad-connector": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "bash test/live/run-all.sh",
    "addon:build": "bash scripts/build-addon.sh",
    "addon:install": "bash scripts/install-addon.sh",
    "archicad:restart": "bash scripts/archicad.sh restart",
    "docs:tools": "tsx scripts/gen-tool-reference.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "archicad",
    "graphisoft",
    "bim",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
